    <div class="container py-5">
        <div class="row">
            <?php
            $sql = $conn->query("SELECT * FROM categorys");
            while ($data = $sql->fetch_assoc()) {
                $cat_id = $data['id'];
                $sql2 = $conn->query("SELECT * FROM sell WHERE category_id='$cat_id' AND status='1'");
                $count = mysqli_num_rows($sql2);
            ?>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card p-4">
                        <div class="d-flex align-items-center">
                            <img src="<?= htmlspecialchars($data['logo_url']) ?>" class="rounded-circle me-3" height="60" width="60">
                            <div>
                                <h5 class="mb-1 fw-bold text-dark"><?= htmlspecialchars($data['name']) ?></h5>
                                <small class="text-muted">Available: <?= $count ?></small>
                            </div>
                            <span class="badge badge-price ms-auto">₹<?= htmlspecialchars($data['amount']) ?></span>
                        </div>
                        <p class="mt-3 text-muted"><?= htmlspecialchars($data['info']) ?></p>
                        <?php if ($count > 0) { ?>
                            <a href="check.php?id=<?= $cat_id ?>" class="btn btn-primary w-100">Buy Now</a>
                        <?php } else { ?>
                            <button class="btn btn-secondary w-100" disabled>Out of Stock</button>
                        <?php } ?>
                    </div>
                </div>
            <?php } ?>
        </div>

        <?php if ($paymentDone && $idPass) { ?>
            <div class="text-center mt-5">
                <button id="showIdPass" class="btn btn-success">Show Your ID & Pass</button>
                <div id="idPassContainer" class="alert alert-info mt-3" style="display: none;">
                    Your ID & Pass: <strong><?= htmlspecialchars($idPass) ?></strong>
                </div>
            </div>
        <?php } ?>
    </div>

    <footer class="footer">
        &copy; <?= date('Y') ?> OTT STORE PREMIUM. All rights reserved.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if(entry.isIntersecting){
                        entry.target.classList.add('visible');
                    }
                });
            });
            document.querySelectorAll('.card').forEach(card => observer.observe(card));

            const showIdPassBtn = document.getElementById('showIdPass');
            if(showIdPassBtn) {
                showIdPassBtn.addEventListener('click', () => {
                    document.getElementById('idPassContainer').style.display = 'block';
                });
            }
        });
    </script>
</body>
</html>