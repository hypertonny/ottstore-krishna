        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 18px rgba(0,123,255,0.3);
        }
        .badge-price {
            background-color: #28a745;
            font-size: 1rem;
        }
        .footer {
            padding: 20px;
            background-color: #34495e;
            color: #ffffff;
            text-align: center;
            margin-top: 50px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="#">OTT STORE PREMIUM</a>
            <div class="ms-auto">
                <?php if (!$isLoggedIn) { ?>
                    <a href="login.php" class="btn btn-outline-light me-2">Login</a>
