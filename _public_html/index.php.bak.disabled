<?php
session_start();
include("./auth.php");
$isLoggedIn = isset($_SESSION['auth']);

// Ensure database connection is established
include("./db_connection.php");

// Assume payment completion check
$paymentDone = isset($_SESSION['payment_done']);
$idPass = isset($_SESSION['id_pass']) ? $_SESSION['id_pass'] : null;
?>

